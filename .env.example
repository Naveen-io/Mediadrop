# ==============================================================================
# MediaDrop Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# For Local Development / Windows Launcher:
NEXT_PUBLIC_API_URL="http://localhost:8000"

# For Public Netlify Deployment (point this to your deployed Render/Railway backend URL):
# NEXT_PUBLIC_API_URL="https://mediadrop-backend.onrender.com"

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="MediaDrop API"
APP_VERSION="1.0.0"
DEBUG=false
PORT=8000

# Storage & Quotas (MB)
TEMP_DIR="temp_media"
MAX_STORAGE_MB=2048
MAX_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SEC=14400

# Security & Limits
DOWNLOAD_TIMEOUT_SEC=300
RATE_LIMIT_CALLS=40
RATE_LIMIT_WINDOW_SEC=60

# Allowed CORS Origins (use "*" for all, or specify your Netlify domain)
# ALLOWED_ORIGINS="https://your-site.netlify.app,http://localhost:3000"
ALLOWED_ORIGINS="*"
