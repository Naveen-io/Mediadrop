<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#F2141517" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FA1C1D21" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#33FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#3AFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextWordmarkBrush" Color="#737984" />

    <!-- Accents & Indicators -->
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2638BDF8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <!-- Interactive -->
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#33FFFFFF" />

</ResourceDictionary>
