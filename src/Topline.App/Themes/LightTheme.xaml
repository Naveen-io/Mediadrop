<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#F2F8F9FA" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#17000000" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#20000000" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="#12000000" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#28000000" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextWordmarkBrush" Color="#9CA3AF" />

    <!-- Accents & Indicators -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A0284C7" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <!-- Interactive -->
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#14000000" />

</ResourceDictionary>
