<Window x:Class="Topline.App.Views.ExpandedPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topline Activity"
        Width="410"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Deactivated="OnWindowDeactivated"
        KeyDown="OnWindowKeyDown">

    <Border Margin="10,0,10,12"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">

        <!-- Outer Drop Shadow -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Opacity="0.35"
                              ShadowDepth="6"
                              Direction="270"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <!-- Section 1: Currently Happening Header & Items -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Section 2: Quick Actions Header & Grid -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Section 3: Recent Activity Header & List -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= SECTION 1: CURRENTLY HAPPENING ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="CURRENTLY HAPPENING"
                           FontFamily="{StaticResource AppFontMedium}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ActiveCountText"
                           Text="0 active"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Active Activities Container -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- Quiet Empty State (Visible when no active activities) -->
                <Border x:Name="EmptyStateBorder"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,12"
                        Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE730;"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desktop is quiet"
                                       FontFamily="{StaticResource AppFontMedium}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="No background operations in progress"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Activities List -->
                <ItemsControl x:Name="ActiveActivitiesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Activity Icon Glyph -->
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">
                                        <TextBlock FontFamily="{StaticResource IconFont}"
                                                   Text="{Binding IconGlyph}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Title & Subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource AppFontMedium}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0">
                                        <!-- Primary Action -->
                                        <Button Style="{StaticResource InlineActionButton}"
                                                Width="28"
                                                Height="28"
                                                Margin="2,0"
                                                ToolTip="{Binding PrimaryActionLabel}"
                                                Tag="{Binding}"
                                                Click="OnActiveItemPrimaryActionClick">
                                            <TextBlock FontFamily="{StaticResource IconFont}"
                                                       Text="{Binding PrimaryActionGlyph}"
                                                       FontSize="12" />
                                        </Button>

                                        <!-- Secondary Action -->
                                        <Button Style="{StaticResource InlineActionButton}"
                                                Width="28"
                                                Height="28"
                                                Margin="2,0"
                                                ToolTip="{Binding SecondaryActionLabel}"
                                                Tag="{Binding}"
                                                Click="OnActiveItemSecondaryActionClick">
                                            <TextBlock FontFamily="{StaticResource IconFont}"
                                                       Text="{Binding SecondaryActionGlyph}"
                                                       FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================= SECTION 2: QUICK ACTIONS ================= -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="QUICK ACTIONS"
                           FontFamily="{StaticResource AppFontMedium}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 2x3 Grid of Clean Shortcuts -->
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,14">
                <!-- Downloads -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="0,0,4,4"
                        Click="OnQuickActionDownloadsClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE896;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Downloads"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- File Explorer -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="2,0,2,4"
                        Click="OnQuickActionExplorerClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE8DA;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Explorer"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Sound Mixer -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="4,0,0,4"
                        Click="OnQuickActionSoundClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE767;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Volume"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clipboard History (Win+V) -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="0,2,4,0"
                        Click="OnQuickActionClipboardClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xF0E3;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Clipboard"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Quick Timer -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="2,2,2,0"
                        Click="OnQuickActionTimerClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE916;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Timer 25m"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Settings -->
                <Button Style="{StaticResource QuickActionButton}"
                        Margin="4,2,0,0"
                        Click="OnQuickActionSettingsClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   Text="&#xE713;"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Settings"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ================= SECTION 3: RECENT ACTIVITY ================= -->
            <Grid Grid.Row="4" Margin="0,0,0,6">
                <TextBlock Text="RECENT ACTIVITY"
                           FontFamily="{StaticResource AppFontMedium}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Clear History Button -->
                <Button x:Name="ClearHistoryButton"
                        Style="{StaticResource TopBarButton}"
                        HorizontalAlignment="Right"
                        Padding="6,2"
                        Click="OnClearHistoryClick">
                    <TextBlock Text="Clear"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
            </Grid>

            <!-- Recent History List (Scrollable if multiple items) -->
            <ScrollViewer Grid.Row="5"
                          MaxHeight="170"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="NoHistoryText"
                               Text="No recent activity logged."
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="RecentActivitiesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,6"
                                        BorderBrush="{DynamicResource BorderDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontFamily="{StaticResource IconFont}"
                                                   Text="{Binding IconGlyph}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CompletedAt, StringFormat='HH:mm'}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
